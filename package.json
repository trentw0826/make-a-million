{
  "name": "make-a-million",
  "private": true,
  "version": "0.1.0",
  "description": "Web-playable Make-a-Million: rules engine, bots, live multiplayer.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mam/server --filter @mam/client dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && stylelint \"apps/client/src/**/*.css\"",
    "lint:fix": "biome check --write . && stylelint --fix \"apps/client/src/**/*.css\"",
    "format": "biome format --write .",
    "sim": "pnpm --filter @mam/sim start",
    "e2e": "pnpm build && tsx apps/client/e2e/smoke.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "stylelint": "17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.1.0"
  }
}
