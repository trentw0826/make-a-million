#!/bin/sh
# Runs the real GitHub CLI with the mounted fine-grained token, read fresh on each call, so the
# token is never left in a shell's environment or in gh's own config.
set -eu

if [ -r "${GITHUB_TOKEN_FILE:-}" ]; then
  GH_TOKEN="$(tr -d '[:space:]' < "$GITHUB_TOKEN_FILE")"
  export GH_TOKEN
fi
exec /usr/bin/gh "$@"
