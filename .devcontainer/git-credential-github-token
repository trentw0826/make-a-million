#!/bin/sh
# Git credential helper: answers requests for github.com with the fine-grained token mounted
# at $GITHUB_TOKEN_FILE, and ignores "store" and "erase" so git never writes it anywhere.
set -eu

[ "${1:-}" = "get" ] || exit 0

host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done

[ "$host" = "github.com" ] || exit 0
[ -r "${GITHUB_TOKEN_FILE:-}" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$(tr -d '[:space:]' < "$GITHUB_TOKEN_FILE")"
